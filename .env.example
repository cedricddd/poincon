# Database
DATABASE_URL="postgresql://pointon:pointon_dev_password@db:5432/pointon"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Optional: Database credentials for docker-compose
DB_USER="pointon"
DB_PASSWORD="pointon_dev_password"
DB_NAME="pointon"

# Stripe — https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_SOLO_MONTHLY=""
STRIPE_PRICE_SOLO_YEARLY=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_YEARLY=""

# Cron secret — protège les routes /api/cron/*
CRON_SECRET="your-cron-secret-here"

# Email — SMTP (optionnel, emails silencieux si absent)
# Prod : boîte noreply@pointon.be sur Mailcow (STARTTLS obligatoire).
# N'importe quel relais SMTP fonctionne en changeant ces valeurs.
SMTP_HOST="mail.pointon.be"
SMTP_PORT="587"
SMTP_USER="noreply@pointon.be"
SMTP_PASS="mot-de-passe-de-la-boite"
MAIL_FROM="noreply@pointon.be"

# Odoo — sync factures (optionnel, désactivé si ODOO_URL absent)
# API Key dans Odoo : Paramètres → Technique → Clés API
ODOO_URL="https://myodoo.odoo.com"
ODOO_DB="mydb"
ODOO_USERNAME="admin"
ODOO_PASSWORD="your-odoo-api-key"
