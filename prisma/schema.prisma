generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(cuid())
  name                  String?
  email                 String          @unique
  emailVerified         DateTime?
  password              String?
  image                 String?
  role                  String          @default("EMPLOYEE")
  active                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  accounts              Account[]
  sessions              Session[]
  clockRecords          ClockRecord[]
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  userConsents          UserConsent[]
  userSchedule          UserSchedule?
  timeOffRequests       TimeOffRequest[] @relation("TimeOffRequests")
  approvedTimeOffs      TimeOffRequest[] @relation("ApprovedTimeOffs")
  detectedOvertimes     DetectedOvertime[] @relation("DetectedOvertimes")
  approvedDetectedOvertimes DetectedOvertime[] @relation("ApprovedDetectedOvertimes")
  rttRequests           RTTRequest[] @relation("RTTRequests")
  approvedRTTs          RTTRequest[] @relation("ApprovedRTTs")
  notifications         Notification[]
  company               Company?        @relation("CompanyAdmin")
  companyId             String?
  companyMember         Company?        @relation("CompanyMembers", fields: [companyId], references: [id])
  teamMemberships       TeamMember[]
  shifts                Shift[]
  defaultSiteId         String?
  defaultSite           Site?           @relation("DefaultSite", fields: [defaultSiteId], references: [id])
  twoFactorEnabled      Boolean         @default(false)
  twoFactorSecret       String?
  twoFactorTrustedUntil DateTime?
  apiKeys               ApiKey[]
  managerId             String?
  manager               User?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates          User[]          @relation("EmployeeManager")
  kioskPin              String?
  kioskVisitsHosted     KioskVisit[]
  locale                String?

  @@index([email])
  @@index([companyId])
  @@index([managerId])
}


model Account {
  id                    String          @id @default(cuid())
  userId                String
  type                  String
  provider              String
  providerAccountId     String
  refresh_token         String?
  access_token          String?
  expires_at            Int?
  token_type            String?
  scope                 String?
  id_token              String?
  session_state         String?

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                    String          @id @default(cuid())
  sessionToken          String          @unique
  userId                String
  expires               DateTime
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier            String
  token                 String          @unique
  expires               DateTime

  @@unique([identifier, token])
}

model Site {
  id               String        @id @default(cuid())
  name             String
  address          String?
  active           Boolean       @default(true)
  companyId        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  qrToken          String?       @unique

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]        @relation("DefaultSite")
  clockRecords ClockRecord[]
  shifts       Shift[]
  kioskTokens  KioskToken[]

  @@index([active])
  @@index([companyId])
  @@index([qrToken])
}

model Plan {
  id                    String          @id @default(cuid())
  name                  String          @unique // FREE | STARTER | TEAM | BUSINESS | ENTERPRISE
  maxEmployees          Int             // -1 = illimité
  maxManagers           Int             // 0 = pas de managers
  maxCsvExportsPerMonth Int             // -1 = illimité, 0 = désactivé
  scheduledExport       String?         // null | "monthly" | "weekly"
  hasTeams              Boolean         @default(false)
  hasAdvancedReports    Boolean         @default(false)
  hasKiosk              Boolean         @default(false)
  hasPlanning           Boolean         @default(false)
  baseIncludedSeats     Int             @default(0)  // seats included in base price
  pricePerExtraSeatCents Int            @default(0)  // price per extra seat in euro cents
  stripePriceIdMonthly  String?
  stripePriceIdYearly   String?
  createdAt             DateTime        @default(now())

  companies             Company[]
}

model Company {
  id                    String          @id @default(cuid())
  name                  String
  address               String
  phone                 String
  vatNumber             String
  domain                String?         @unique
  adminId               String          @unique
  planId                String?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripeSubscriptionBillingCycle String? // "monthly" | "yearly" — null si pas de subscription active
  stripeSeatItemId      String?   // ID du subscription item "sièges supplémentaires" (pour update quantity)
  billedSeats           Int       @default(0) // dernière quantité de sièges supp. poussée vers Stripe
  stripeCurrentPeriodStart DateTime? // début de la période en cours (Stripe)
  stripeCurrentPeriodEnd   DateTime? // fin de la période en cours = date de prochain renouvellement
  stripeCancelAtPeriodEnd Boolean @default(false)
  planExpiresAt         DateTime?
  enterprisePaidStatus  String?           // "PAID" | "UNPAID" | "PENDING" — Enterprise uniquement
  enterprisePlanStartedAt DateTime?       // date de début du contrat Enterprise
  logoUrl               String?
  contactEmail          String?         // email de contact pour rappels paiement
  lastActivityAt        DateTime?       // mis à jour après chaque pointage (timestamp uniquement)
  isDemo                Boolean         @default(false) // compte démo — bannière visible, pas d'emails
  isInternal            Boolean         @default(false) // compte interne Ced-IT — exclu des stats SuperAdmin
  marketingConsent      Boolean         @default(false) // pour les emails marketing
  onboardingCompleted   Boolean         @default(false)
  presenceForManagers  Boolean         @default(true)
  presenceForEmployees Boolean         @default(true)
  mealBreakEnabled     Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?       // soft delete pour RGPD

  admin                 User            @relation("CompanyAdmin", fields: [adminId], references: [id])
  members               User[]          @relation("CompanyMembers")
  plan                  Plan?           @relation(fields: [planId], references: [id])
  teams                 Team[]
  rotationCycles        RotationCycle[]
  sites                 Site[]
  featureFlags          CompanyFeatureFlag[]
  planHistory           PlanHistory[]
  invitations           UserInvitation[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  kioskTokens           KioskToken[]
  kioskVisits           KioskVisit[]
  stripeInvoices        StripeInvoice[]

  @@index([adminId])
  @@index([planId])
  @@index([stripeCustomerId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([deletedAt])
}

model Team {
  id                    String          @id @default(cuid())
  name                  String
  companyId             String
  rotationCycleId       String?
  rotationPhase         Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company               Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members               TeamMember[]
  rotationCycle         RotationCycle?  @relation(fields: [rotationCycleId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([rotationCycleId])
}

model RotationCycle {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  periodUnit  String           @default("WEEK") // WEEK | DAY
  anchorDate  DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periods     RotationPeriod[]
  teams       Team[]

  @@index([companyId])
}

model RotationPeriod {
  id          String         @id @default(cuid())
  cycleId     String
  order       Int
  label       String
  shiftType   String?
  startTime   String?
  endTime     String?
  workDays    String         @default("[1,2,3,4,5]")

  cycle       RotationCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, order])
  @@index([cycleId])
}

model TeamMember {
  id                    String          @id @default(cuid())
  userId                String
  teamId                String
  role                  String          @default("member")
  createdAt             DateTime        @default(now())

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model CompanyFeatureFlag {
  id         String   @id @default(cuid())
  companyId  String
  flag       String   // ex: "early_access_api", "extended_export"
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, flag])
  @@index([companyId])
}

model PlanHistory {
  id        String   @id @default(cuid())
  companyId String
  fromPlan  String?
  toPlan    String
  changedBy String   // "SUPER_ADMIN" ou "STRIPE_WEBHOOK"
  reason    String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  companyId   String
  createdBy   String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([keyHash])
}

model WebhookEndpoint {
  id          String            @id @default(cuid())
  companyId   String
  url         String
  secret      String
  events      String            @default("[]")
  enabled     Boolean           @default(true)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([companyId])
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  endpointId   String
  event        String
  payload      String
  statusCode   Int?
  responseBody String?
  success      Boolean         @default(false)
  attemptedAt  DateTime        @default(now())

  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([attemptedAt])
}

model ClockRecord {
  id                    String          @id @default(cuid())
  userId                String
  arrivalTime           DateTime
  departureTime         DateTime?
  location              String          @default("Sur site")
  duration              Int?
  date                  DateTime        @default(now())
  createdAt             DateTime        @default(now())

  siteId                String?
  site                  Site?           @relation(fields: [siteId], references: [id])
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks                BreakEntry[]

  @@index([userId])
  @@index([date])
  @@index([siteId])
  @@index([userId, date])       // requêtes mensuelles par employé
  @@index([userId, departureTime]) // détection pointages ouverts
}

model BreakEntry {
  id            String      @id @default(cuid())
  clockRecordId String
  startedAt     DateTime
  endedAt       DateTime?
  createdAt     DateTime    @default(now())

  clockRecord   ClockRecord @relation(fields: [clockRecordId], references: [id], onDelete: Cascade)

  @@index([clockRecordId])
}

model AuditLog {
  id                    String          @id @default(cuid())
  userId                String?         // nullable : mis à null lors de l'anonymisation RGPD
  anonymizedToken       String?         // hash opaque remplaçant userId après anonymisation
  anonymized            Boolean         @default(false)
  action                String
  resource              String
  resourceId            String?
  changes               String?
  ipAddress             String?
  userAgent             String?
  status                String          @default("success")
  createdAt             DateTime        @default(now())

  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([anonymized])
}

model UserConsent {
  id                    String          @id @default(cuid())
  userId                String          @unique
  consentType           String
  consentedAt           DateTime        @default(now())
  consentVersion        String          @default("1.0")

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TimeOffRequest {
  id                    String          @id @default(cuid())
  userId                String
  startDate             DateTime
  endDate               DateTime
  leaveType             String          @default("ANNUAL") // ANNUAL, SICK, MATERNITY
  reason                String?
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("TimeOffRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedTimeOffs", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([approvedBy])
  @@index([userId, status])     // calcul solde : approved timeoffs par user
  @@index([userId, startDate])  // chevauchement congés
  @@index([status, startDate, endDate])  // calendrier équipe : congés approuvés par plage
}

model WorkSchedule {
  id            String         @id @default(cuid())
  name          String
  type          String         // JOURNEE | 2X8 | 3X8 | 4X8 | 5X8 | 2X12 | NUIT | PARTIEL | VARIABLE
  startTime     String         // "06:00"
  endTime       String         // "14:00"
  hoursPerDay   Float          @default(8)
  weeklyHours   Float          @default(38)
  daysOfWeek    String         @default("[1,2,3,4,5]") // JSON: 1=Lun … 7=Dim
  dayConfig     String?        // JSON: {"1":"remote","3":"half"} — per-day type override
  description   String?
  isPreset      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userSchedules UserSchedule[]

  @@index([type])
}

model UserSchedule {
  id             String        @id @default(cuid())
  userId         String        @unique
  hoursPerDay    Float         @default(8)
  scheduleId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSchedule   WorkSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduleId])
}

model DetectedOvertime {
  id                    String          @id @default(cuid())
  userId                String
  date                  DateTime
  hoursWorked           Float           // Heures réellement travaillées
  hoursStandard         Float           // Heures configurées pour cet employé
  overtimeHours         Float           // hoursWorked - hoursStandard
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("DetectedOvertimes", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedDetectedOvertimes", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([approvedBy])
  @@index([userId, status])     // calcul solde : approved overtimes par user
}

model RTTRequest {
  id                    String          @id @default(cuid())
  userId                String
  date                  DateTime        // Date du RTT
  hoursToRecover        Float           // Heures à récupérer (0.5 à 8)
  reason                String?         // Raison optionnelle
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("RTTRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedRTTs", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([approvedBy])
  @@index([userId, status])     // calcul solde : approved RTTs par user
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String   @default("info")  // "success" | "error" | "info"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([userId, read])       // cloche : notifications non lues par user
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model UserInvitation {
  id        String    @id @default(cuid())
  email     String
  name      String?
  token     String    @unique @default(cuid())
  companyId String
  role      String    @default("EMPLOYEE")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId])
  @@index([email])
}

model Shift {
  id        String   @id @default(cuid())
  userId    String
  siteId    String?
  date      DateTime // day of shift (midnight UTC)
  startTime String   // "09:00"
  endTime   String   // "17:00"
  shiftType String?  @default("DAY") // DAY | MORNING | AFTERNOON | NIGHT
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site?    @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([userId, date])
}

model SuperAdminItem {
  id        String   @id @default(cuid())
  type      String   // 'NOTE' | 'LINK' | 'EVENT' | 'TASK'
  title     String   @default("")
  content   String?  // contenu libre (notes)
  url       String?  // pour les liens
  date      String?  // YYYY-MM-DD pour les événements agendés
  time      String?  // HH:MM optionnel
  eventType String?  // 'CALL' | 'DEMO' | 'TASK' | 'REMINDER'
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StripeInvoice {
  id              String    @id @default(cuid())
  stripeInvoiceId String    @unique
  companyId       String
  amountPaid      Int       // centimes TTC
  currency        String    @default("eur")
  plan            String?
  odooInvoiceId   Int?
  odooSyncedAt    DateTime?
  createdAt       DateTime  @default(now())

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model KioskToken {
  id               String   @id @default(cuid())
  token            String   @unique
  companyId        String
  siteId           String?
  label            String?
  theme            String   @default("dark")
  visitorsEnabled  Boolean  @default(true)
  createdAt        DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site?    @relation(fields: [siteId], references: [id])

  @@index([companyId])
  @@index([token])
}

model KioskVisit {
  id           String    @id @default(cuid())
  companyId    String
  siteId       String?
  visitorName  String
  visitorEmail String
  hostUserId   String
  arrivedAt    DateTime  @default(now())
  departedAt   DateTime?

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  host         User      @relation(fields: [hostUserId], references: [id])

  @@index([companyId])
  @@index([arrivedAt])
}
