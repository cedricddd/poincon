generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(cuid())
  name                  String?
  email                 String          @unique
  emailVerified         DateTime?
  password              String?
  image                 String?
  role                  String          @default("EMPLOYEE")
  active                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  accounts              Account[]
  sessions              Session[]
  clockRecords          ClockRecord[]
  auditLogs             AuditLog[]
  userConsents          UserConsent[]
  userSchedule          UserSchedule?
  timeOffRequests       TimeOffRequest[] @relation("TimeOffRequests")
  approvedTimeOffs      TimeOffRequest[] @relation("ApprovedTimeOffs")
  detectedOvertimes     DetectedOvertime[] @relation("DetectedOvertimes")
  approvedDetectedOvertimes DetectedOvertime[] @relation("ApprovedDetectedOvertimes")
  rttRequests           RTTRequest[] @relation("RTTRequests")
  approvedRTTs          RTTRequest[] @relation("ApprovedRTTs")
  notifications         Notification[]
  company               Company?        @relation("CompanyAdmin")
  companyId             String?
  companyMember         Company?        @relation("CompanyMembers", fields: [companyId], references: [id])
  teamMemberships       TeamMember[]
  defaultSiteId         String?
  defaultSite           Site?           @relation("DefaultSite", fields: [defaultSiteId], references: [id])

  @@index([email])
  @@index([companyId])
}


model Account {
  id                    String          @id @default(cuid())
  userId                String
  type                  String
  provider              String
  providerAccountId     String
  refresh_token         String?
  access_token          String?
  expires_at            Int?
  token_type            String?
  scope                 String?
  id_token              String?
  session_state         String?

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                    String          @id @default(cuid())
  sessionToken          String          @unique
  userId                String
  expires               DateTime
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier            String
  token                 String          @unique
  expires               DateTime

  @@unique([identifier, token])
}

model Site {
  id           String        @id @default(cuid())
  name         String
  address      String?
  active       Boolean       @default(true)
  companyId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users        User[]        @relation("DefaultSite")
  clockRecords ClockRecord[]

  @@index([active])
  @@index([companyId])
}

model Plan {
  id                    String          @id @default(cuid())
  name                  String          @unique // FREE | SOLO | TEAM | ENTERPRISE
  maxEmployees          Int             // -1 = illimité
  maxManagers           Int             // 0 = pas de managers
  maxCsvExportsPerMonth Int             // -1 = illimité, 0 = désactivé
  scheduledExport       String?         // null | "monthly" | "weekly"
  hasTeams              Boolean         @default(false)
  hasAdvancedReports    Boolean         @default(false)
  stripePriceIdMonthly  String?
  stripePriceIdYearly   String?
  createdAt             DateTime        @default(now())

  companies             Company[]
}

model Company {
  id                    String          @id @default(cuid())
  name                  String
  address               String?
  phone                 String?
  vatNumber             String?
  domain                String?         @unique
  adminId               String          @unique
  planId                String?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripeSubscriptionBillingCycle String? // "monthly" | "yearly" — null si pas de subscription active
  stripeCancelAtPeriodEnd Boolean @default(false)
  planExpiresAt         DateTime?
  logoUrl               String?
  contactEmail          String?         // email de contact pour rappels paiement
  lastActivityAt        DateTime?       // mis à jour après chaque pointage (timestamp uniquement)
  marketingConsent      Boolean         @default(false) // pour les emails marketing
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?       // soft delete pour RGPD

  admin                 User            @relation("CompanyAdmin", fields: [adminId], references: [id])
  members               User[]          @relation("CompanyMembers")
  plan                  Plan?           @relation(fields: [planId], references: [id])
  teams                 Team[]
  sites                 Site[]
  featureFlags          CompanyFeatureFlag[]
  planHistory           PlanHistory[]
  invitations           UserInvitation[]

  @@index([adminId])
  @@index([planId])
  @@index([stripeCustomerId])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([deletedAt])
}

model Team {
  id                    String          @id @default(cuid())
  name                  String
  companyId             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company               Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members               TeamMember[]

  @@index([companyId])
}

model TeamMember {
  id                    String          @id @default(cuid())
  userId                String
  teamId                String
  role                  String          @default("member")
  createdAt             DateTime        @default(now())

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model CompanyFeatureFlag {
  id         String   @id @default(cuid())
  companyId  String
  flag       String   // ex: "early_access_api", "extended_export"
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, flag])
  @@index([companyId])
}

model PlanHistory {
  id        String   @id @default(cuid())
  companyId String
  fromPlan  String?
  toPlan    String
  changedBy String   // "SUPER_ADMIN" ou "STRIPE_WEBHOOK"
  reason    String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model ClockRecord {
  id                    String          @id @default(cuid())
  userId                String
  arrivalTime           DateTime
  departureTime         DateTime?
  location              String          @default("Sur site")
  duration              Int?
  date                  DateTime        @default(now())
  createdAt             DateTime        @default(now())

  siteId                String?
  site                  Site?           @relation(fields: [siteId], references: [id])
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([siteId])
  @@index([userId, date])       // requêtes mensuelles par employé
  @@index([userId, departureTime]) // détection pointages ouverts
}

model AuditLog {
  id                    String          @id @default(cuid())
  userId                String?         // nullable : mis à null lors de l'anonymisation RGPD
  anonymizedToken       String?         // hash opaque remplaçant userId après anonymisation
  anonymized            Boolean         @default(false)
  action                String
  resource              String
  resourceId            String?
  changes               String?
  ipAddress             String?
  userAgent             String?
  status                String          @default("success")
  createdAt             DateTime        @default(now())

  user                  User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([anonymized])
}

model UserConsent {
  id                    String          @id @default(cuid())
  userId                String          @unique
  consentType           String
  consentedAt           DateTime        @default(now())
  consentVersion        String          @default("1.0")

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TimeOffRequest {
  id                    String          @id @default(cuid())
  userId                String
  startDate             DateTime
  endDate               DateTime
  reason                String?
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("TimeOffRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedTimeOffs", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([approvedBy])
  @@index([userId, status])     // calcul solde : approved timeoffs par user
  @@index([userId, startDate])  // chevauchement congés
  @@index([status, startDate, endDate])  // calendrier équipe : congés approuvés par plage
}

model WorkSchedule {
  id            String         @id @default(cuid())
  name          String
  type          String         // JOURNEE | 2X8 | 3X8 | 4X8 | 5X8 | 2X12 | NUIT | PARTIEL | VARIABLE
  startTime     String         // "06:00"
  endTime       String         // "14:00"
  hoursPerDay   Float          @default(8)
  weeklyHours   Float          @default(38)
  daysOfWeek    String         @default("[1,2,3,4,5]") // JSON: 1=Lun … 7=Dim
  description   String?
  isPreset      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userSchedules UserSchedule[]

  @@index([type])
}

model UserSchedule {
  id             String        @id @default(cuid())
  userId         String        @unique
  hoursPerDay    Float         @default(8)
  scheduleId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workSchedule   WorkSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduleId])
}

model DetectedOvertime {
  id                    String          @id @default(cuid())
  userId                String
  date                  DateTime
  hoursWorked           Float           // Heures réellement travaillées
  hoursStandard         Float           // Heures configurées pour cet employé
  overtimeHours         Float           // hoursWorked - hoursStandard
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("DetectedOvertimes", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedDetectedOvertimes", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([approvedBy])
  @@index([userId, status])     // calcul solde : approved overtimes par user
}

model RTTRequest {
  id                    String          @id @default(cuid())
  userId                String
  date                  DateTime        // Date du RTT
  hoursToRecover        Float           // Heures à récupérer (0.5 à 8)
  reason                String?         // Raison optionnelle
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("RTTRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedRTTs", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([approvedBy])
  @@index([userId, status])     // calcul solde : approved RTTs par user
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String   @default("info")  // "success" | "error" | "info"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([userId, read])       // cloche : notifications non lues par user
}

model UserInvitation {
  id        String    @id @default(cuid())
  email     String
  name      String?
  token     String    @unique @default(cuid())
  companyId String
  role      String    @default("EMPLOYEE")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId])
  @@index([email])
}
