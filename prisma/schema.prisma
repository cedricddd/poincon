generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(cuid())
  name                  String?
  email                 String          @unique
  emailVerified         DateTime?
  password              String?
  image                 String?
  role                  String          @default("EMPLOYEE")
  active                Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  accounts              Account[]
  sessions              Session[]
  clockRecords          ClockRecord[]
  auditLogs             AuditLog[]
  userConsents          UserConsent[]
  userSchedule          UserSchedule?
  timeOffRequests       TimeOffRequest[] @relation("TimeOffRequests")
  approvedTimeOffs      TimeOffRequest[] @relation("ApprovedTimeOffs")
  detectedOvertimes     DetectedOvertime[] @relation("DetectedOvertimes")
  approvedDetectedOvertimes DetectedOvertime[] @relation("ApprovedDetectedOvertimes")
  rttRequests           RTTRequest[] @relation("RTTRequests")
  approvedRTTs          RTTRequest[] @relation("ApprovedRTTs")
  notifications         Notification[]
  company               Company?        @relation("CompanyAdmin")
  companyId             String?

  @@index([email])
  @@index([companyId])
}


model Account {
  id                    String          @id @default(cuid())
  userId                String
  type                  String
  provider              String
  providerAccountId     String
  refresh_token         String?
  access_token          String?
  expires_at            Int?
  token_type            String?
  scope                 String?
  id_token              String?
  session_state         String?

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                    String          @id @default(cuid())
  sessionToken          String          @unique
  userId                String
  expires               DateTime
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier            String
  token                 String          @unique
  expires               DateTime

  @@unique([identifier, token])
}

model Company {
  id                    String          @id @default(cuid())
  name                  String
  domain                String?         @unique
  adminId               String          @unique
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  admin                 User            @relation("CompanyAdmin", fields: [adminId], references: [id])
  teams                 Team[]

  @@index([adminId])
}

model Team {
  id                    String          @id @default(cuid())
  name                  String
  companyId             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company               Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members               TeamMember[]

  @@index([companyId])
}

model TeamMember {
  id                    String          @id @default(cuid())
  userId                String
  teamId                String
  role                  String          @default("member")
  createdAt             DateTime        @default(now())

  team                  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model ClockRecord {
  id                    String          @id @default(cuid())
  userId                String
  arrivalTime           DateTime
  departureTime         DateTime?
  location              String          @default("Sur site")
  duration              Int?
  date                  DateTime        @default(now())
  createdAt             DateTime        @default(now())

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model AuditLog {
  id                    String          @id @default(cuid())
  userId                String
  action                String
  resource              String
  resourceId            String?
  changes               String?
  ipAddress             String?
  userAgent             String?
  status                String          @default("success")
  createdAt             DateTime        @default(now())

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model UserConsent {
  id                    String          @id @default(cuid())
  userId                String          @unique
  consentType           String
  consentedAt           DateTime        @default(now())
  consentVersion        String          @default("1.0")

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TimeOffRequest {
  id                    String          @id @default(cuid())
  userId                String
  startDate             DateTime
  endDate               DateTime
  reason                String?
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("TimeOffRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedTimeOffs", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([approvedBy])
}

model UserSchedule {
  id                    String          @id @default(cuid())
  userId                String          @unique
  hoursPerDay           Float           @default(8) // Heures standards par jour (4, 5, 8, etc.)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DetectedOvertime {
  id                    String          @id @default(cuid())
  userId                String
  date                  DateTime
  hoursWorked           Float           // Heures réellement travaillées
  hoursStandard         Float           // Heures configurées pour cet employé
  overtimeHours         Float           // hoursWorked - hoursStandard
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("DetectedOvertimes", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedDetectedOvertimes", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([approvedBy])
}

model RTTRequest {
  id                    String          @id @default(cuid())
  userId                String
  date                  DateTime        // Date du RTT
  hoursToRecover        Float           // Heures à récupérer (0.5 à 8)
  reason                String?         // Raison optionnelle
  status                String          @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy            String?
  approvedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user                  User            @relation("RTTRequests", fields: [userId], references: [id], onDelete: Cascade)
  approver              User?           @relation("ApprovedRTTs", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@index([date])
  @@index([approvedBy])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String   @default("info")  // "success" | "error" | "info"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}
